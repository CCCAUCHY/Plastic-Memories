{
  "name": "dsh-plugin-plastic-memories-h0",
  "version": "0.50.85",
  "description": "Plastic Memories — H0 route: plastic memory projection over DSH surfaceOp",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./markers": "./markers.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "commands.js",
    "generations.js",
    "units.js",
    "unitops.js",
    "boundaries.js",
    "safetyreplay.js",
    "engine.js",
    "coords.js",
    "grouping.js",
    "cookie.js",
    "retrospect.js",
    "overlap.js",
    "schema.js",
    "markers.js",
    "capture.js",
    "cordis.patch.yml",
    "presets/*.yml",
    "locale/*.json",
    "messages.js",
    "opshape.js",
    "repair-ignorable.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "context-management",
    "plastic-memories"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "scripts": {},
  "devDependencies": null
}
