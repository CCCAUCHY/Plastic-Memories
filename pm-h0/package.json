{
  "name": "dsh-plugin-plastic-memories-h0",
  "version": "0.50.68",
  "description": "Plastic Memories — H0 route: plastic memory projection over DSH surfaceOp",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./markers": "./markers.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "commands.js",
    "generations.js",
    "units.js",
    "unitops.js",
    "boundaries.js",
    "safetyreplay.js",
    "engine.js",
    "coords.js",
    "grouping.js",
    "cookie.js",
    "plasticize.js",
    "preview.js",
    "retrospect.js",
    "overlap.js",
    "schema.js",
    "markers.js",
    "capture.js",
    "cordis.patch.yml",
    "presets/*.yml",
    "locale/*.json",
    "messages.js",
    "opshape.js",
    "pending.js"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "context-management",
    "plastic-memories"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node contract.mjs && node integration.mjs && node unitest.mjs && node globaltest.mjs && node ptctest.mjs && node multicall.mjs && node groupingtest.mjs && node contexttest.mjs && node verifytest.mjs && node versioncheck.mjs && node oracletest.mjs && node spectest.mjs && node gentest.mjs",
    "test:selftest": "node selftest.mjs",
    "test:integration": "node integration.mjs",
    "test:hooks": "node hooks.mjs",
    "test:ptctest": "node ptctest.mjs",
    "test:multicall": "node multicall.mjs",
    "test:version": "node versioncheck.mjs",
    "test:ui": "node uitest.mjs",
    "build:client": "node build-client.mjs",
    "rebuild:dsh": "node rebuild-from-dsh.mjs",
    "check:dsh": "node rebuild-from-dsh.mjs --check",
    "test:diff": "node diffcheck.mjs",
    "test:verify": "node verifytest.mjs",
    "test:unit": "node unitest.mjs",
    "test:global": "node globaltest.mjs",
    "test:contract": "node contract.mjs"
  }
}
